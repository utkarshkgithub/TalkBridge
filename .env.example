APP_ENV=dev
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talkbridge
# Set a random secret before accepting GitHub deliveries.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM text with escaped newlines is supported.
GITHUB_PRIVATE_KEY=
WORKER_COUNT=1
WORKER_QUEUE_SIZE=100
SEMGREP_TIMEOUT_SECONDS=5
ENFORCE_STYLE_DIFF=false
LORA_ENABLED=false
DEMO_REPLAY_MODE=true
SANDBOX_TEST_ENABLED=false
# Stage 1-4 are opt-in; publishing defaults to a network-free dry run.
REVIEW_ENABLED=false
GITHUB_PUBLISH_ENABLED=false
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
# Use guided_json only for vLLM <0.12. Current servers use structured_outputs.
VLLM_SCHEMA_MODE=structured_outputs
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_TOKENS=4096
VERIFIER_CONCURRENCY=4
MAX_CANDIDATES_PER_AGENT=20
PROMPT_MAX_CHARS=100000

# Brick 3 dashboard and replay persistence use Docker PostgreSQL.
STORAGE_ENABLED=true
# Live sample requests must finish before the frontend proxy timeout (maximum 150 seconds).
LIVE_REVIEW_TIMEOUT_SECONDS=150
