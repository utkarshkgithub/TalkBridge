# Copy to .env.local. Use this exact origin in the browser and OAuth callbacks.
BACKEND_URL=http://127.0.0.1:8000
AUTH_URL=http://127.0.0.1:3000
# Public canonical origin for SEO and social links. Defaults to AUTH_URL.
# SITE_URL=https://your-public-domain.example
# Set true for preview/staging deployments. Development and localhost never index.
SITE_NOINDEX=false
# Required in production: generate with openssl rand -hex 32.
# Development generates and persists a local encryption key when omitted.
AUTH_SECRET=
# Production shared-workspace membership, comma-separated immutable provider IDs.
# Example: github:123456,google:123456789012345678901
# Required in production: unlisted identities cannot sign in or use sessions.
# Development allows provider accounts so local OAuth setup can be tested.
AUTH_ALLOWED_IDENTITIES=
# Must match backend DASHBOARD_API_KEY. Required for production.
DASHBOARD_API_KEY=
# Optional persistent SQLite path. Defaults to frontend/data/auth.db.
# Keep this database and AUTH_SECRET across restarts. One Node server instance.
# AUTH_DATABASE_PATH=/absolute/private/path/auth.db

# Local test sign-in is always disabled when NODE_ENV=production.
DEMO_AUTH_ENABLED=true
# Defaults: demo@talkbridge.local / TalkBridgeDemo!2026.
# Setting either override hides the default credentials from the login screen.
# DEMO_AUTH_EMAIL=demo@talkbridge.local
# DEMO_AUTH_PASSWORD=replace-with-your-local-test-password

# GitHub OAuth App, for sign-in and repository connections.
# Callback: http://127.0.0.1:3000/api/auth/callback/github
# Login requests profile/email. Connecting additionally requests repo access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Web OAuth client, for sign-in only.
# Authorized redirect URI: http://127.0.0.1:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitLab.com OAuth application, for repository connections.
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/gitlab
# Scopes: read_user read_api read_repository
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Bitbucket Cloud OAuth consumer, for repository connections.
# Callback: http://127.0.0.1:3000/api/auth/callback/bitbucket
# Enable account read and repository read permissions on the consumer.
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# For deployment, replace AUTH_URL and every registered callback with HTTPS.
# OAuth repository connections do not replace the backend GitHub App settings.
